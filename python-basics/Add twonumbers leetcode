class Solution:
    def addTwoNumbers(self, l1, l2):
        dummy = ListNode(0)   # a starting box to build the answer from
        current = dummy
        carry = 0

        while l1 or l2 or carry:
            total = carry
            if l1:
                total += l1.val
                l1 = l1.next
            if l2:
                total += l2.val
                l2 = l2.next

            carry = total // 10                 # 10 or more? carry 1
            current.next = ListNode(total % 10) # digit to keep
            current = current.next

        return dummy.next
